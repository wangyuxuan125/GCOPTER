Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 245; 245; 245
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 4.75
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: GlobalMap
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.25
          Style: Boxes
          Topic: /voxel_map
          Unreliable: true
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: GlobalMap
    - Class: rviz/MarkerArray
      Name: DAC-SFC stages
      Marker Topic: /dac_sfc_video/markers
      Enabled: true
      Queue Size: 20
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Name: Selected segment
      Target Frame: dac_sfc_focus
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Distance: 14
      Pitch: 0.57
      Yaw: 0.75
      Near Clip Distance: 0.01
      Field of View: 0.785398
