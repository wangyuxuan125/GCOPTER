<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="experiment_log_enabled" default="true"/>
  <arg name="experiment_log_directory" default="$(env HOME)/tf_sfc_results/gcopter"/>
  <arg name="experiment_tag" default="default"/>
  <arg name="map_seed" default="1024"/>
  <arg name="corridor_method" default="firi"/>
  <arg name="allow_corridor_fallback" default="false"/>
  <arg name="tf_sfc_direction_mode" default="1"/>
  <arg name="tf_sfc_samples_per_segment" default="5"/>
  <arg name="tf_sfc_max_faces" default="12"/>
  <arg name="tf_sfc_max_obs_faces" default="6"/>
  <arg name="tf_sfc_safety_margin" default="0.05"/>
  <arg name="tf_sfc_max_inflation_distance" default="1.0"/>
  <arg name="tf_sfc_inflation_step" default="0.10"/>
  <arg name="tf_sfc_min_overlap_radius" default="0.04"/>
  <arg name="tf_sfc_max_segment_length" default="1.0"/>
  <arg name="decomp_local_bbox_forward" default="0.5"/>
  <arg name="decomp_local_bbox_lateral" default="3.0"/>
  <arg name="decomp_local_bbox_vertical" default="3.0"/>
  <arg name="decomp_max_segment_length" default="3.0"/>
  <arg name="decomp_min_overlap_radius" default="0.01"/>

   <node name="rviz" pkg="rviz" type="rviz" output="screen"
    args="-d $(find gcopter)/config/global_planning.rviz"> 
  </node>
  
  <node name="pos_vel_plot" pkg="rqt_plot" type="rqt_plot" 
    args="/visualizer/speed /visualizer/total_thrust /visualizer/tilt_angle /visualizer/body_rate">
  </node>

  <node pkg="mockamap" type="mockamap_node" name="mockamap_node" output="screen">
  <param name="seed" type="int" value="$(arg map_seed)"/>
  <param name="update_freq" type="double" value="1.0"/>
  <param name="resolution" type="double" value="0.25"/>
  <param name="x_length" type="int" value="50"/>
  <param name="y_length" type="int" value="50"/>
  <param name="z_length" type="int" value="5"/>
  <param name="type" type="int" value="1"/>
  <param name="complexity"    type="double" value="0.025"/>
  <param name="fill"          type="double" value="0.3"/>
  <param name="fractal"       type="int"    value="1"/>
  <param name="attenuation"   type="double" value="0.1"/>
  <remap from="/mock_map" to="/voxel_map"/>
  </node>
  
  <node pkg="gcopter" type="global_planning" name="global_planning_node" output="screen">
  <rosparam file="$(find gcopter)/config/global_planning.yaml" command="load" />
  <param name="Experiment/LogEnabled" value="$(arg experiment_log_enabled)" type="bool"/>
  <param name="Experiment/LogDirectory" value="$(arg experiment_log_directory)" type="string"/>
  <param name="Experiment/Tag" value="$(arg experiment_tag)" type="string"/>
  <param name="Experiment/MapSeed" value="$(arg map_seed)" type="int"/>
  <param name="Corridor/Method" value="$(arg corridor_method)" type="string"/>
  <param name="Corridor/AllowFallback" value="$(arg allow_corridor_fallback)" type="bool"/>
  <param name="TfSfc/DirectionMode" value="$(arg tf_sfc_direction_mode)" type="int"/>
  <param name="TfSfc/SamplesPerSegment" value="$(arg tf_sfc_samples_per_segment)" type="int"/>
  <param name="TfSfc/MaxFaces" value="$(arg tf_sfc_max_faces)" type="int"/>
  <param name="TfSfc/MaxObsFaces" value="$(arg tf_sfc_max_obs_faces)" type="int"/>
  <param name="TfSfc/SafetyMargin" value="$(arg tf_sfc_safety_margin)" type="double"/>
  <param name="TfSfc/MaxInflationDistance" value="$(arg tf_sfc_max_inflation_distance)" type="double"/>
  <param name="TfSfc/InflationStep" value="$(arg tf_sfc_inflation_step)" type="double"/>
  <param name="TfSfc/MinOverlapRadius" value="$(arg tf_sfc_min_overlap_radius)" type="double"/>
  <param name="TfSfc/MaxSegmentLength" value="$(arg tf_sfc_max_segment_length)" type="double"/>
  <param name="Decomp/LocalBBoxForward" value="$(arg decomp_local_bbox_forward)" type="double"/>
  <param name="Decomp/LocalBBoxLateral" value="$(arg decomp_local_bbox_lateral)" type="double"/>
  <param name="Decomp/LocalBBoxVertical" value="$(arg decomp_local_bbox_vertical)" type="double"/>
  <param name="Decomp/MaxSegmentLength" value="$(arg decomp_max_segment_length)" type="double"/>
  <param name="Decomp/MinOverlapRadius" value="$(arg decomp_min_overlap_radius)" type="double"/>
  </node>

</launch>
